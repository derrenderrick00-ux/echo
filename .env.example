# Example configuration: only loopback Ollama is supported in Phase 0.
ECHO_MODEL_PROVIDER=ollama
ECHO_OLLAMA_URL=http://127.0.0.1:11434
ECHO_OLLAMA_MODEL=llama3.2:1b
# Additional small embedding model for semantic note search (about 46 MB download)
ECHO_EMBED_MODEL=all-minilm
# Small defaults for CPU-only use; adjust after measuring speed and quality.
ECHO_MAX_TURNS=4
ECHO_MAX_OUTPUT_TOKENS=192
ECHO_CONTEXT_TOKENS=2048
